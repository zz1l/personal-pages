---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base === '/' ? p : base.replace(/\/$/, '') + p);
---

<BaseLayout title="404 · 页面不存在" description="页面不存在。">
  <div class="wrap py-20 text-center">
    <p class="font-mono text-5xl m-0 text-subtle">404</p>
    <h1 class="text-xl font-semibold mt-4 m-0">这篇笔记还不存在——至少现在还没有。</h1>
    <p class="text-muted mt-2">
      你访问的页面可能已被移动、改名，或者从未被写下。
    </p>
    <div class="flex justify-center gap-3 mt-8">
      <a class="btn btn-primary" href={withBase('/')}>回到首页</a>
      <a class="btn" href={withBase('/notes/')}>浏览笔记</a>
    </div>
  </div>
</BaseLayout>
