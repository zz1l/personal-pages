---
import type { Note } from '../lib/notes';
import { noteSlug, updated, readingTime } from '../lib/notes';
import { formatDate } from '../lib/format';
import StatusBadge from './StatusBadge.astro';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = (base === '/' ? '' : base.replace(/\/$/, '')) + '/notes/' + noteSlug(note) + '/';
const category = note.data.subcategory
  ? `${note.data.category} · ${note.data.subcategory}`
  : note.data.category;
---

<a class="note-card" href={href}>
  <div class="flex items-center justify-between gap-3">
    <span class="text-xs text-subtle font-mono">{category}</span>
    <StatusBadge status={note.data.status} />
  </div>
  <h3 class="note-card-title">{note.data.title}</h3>
  {
    note.data.description && <p class="note-card-desc">{note.data.description}</p>
  }
  <div class="note-card-meta">
    {
      note.data.tags.map((tag) => <span class="text-accent">#{tag}</span>)
    }
    <span aria-hidden="true">·</span>
    <time datetime={updated(note).toISOString()}>{formatDate(updated(note))}</time>
    <span aria-hidden="true">·</span>
    <span>约 {readingTime(note)} 分钟</span>
  </div>
</a>
