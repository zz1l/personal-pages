---
import { SITE } from '../config';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base === '/' ? p : base.replace(/\/$/, '') + p);

const links = [
  { href: '/', label: '首页' },
  { href: '/notes/', label: '笔记' },
  { href: '/projects/', label: '项目' },
  { href: '/research/', label: '研究' },
  { href: '/graph/', label: '图谱' },
  { href: '/timeline/', label: '时间线' },
  { href: '/stats/', label: '统计' },
  { href: '/about/', label: '关于' },
];

// Astro.url.pathname 包含 base 路径，先剥掉再匹配。
const path = Astro.url.pathname.replace(new RegExp('^' + base.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')), '/');
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" id="site-header">
  <div class="wrap nav-inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand-mark">{SITE.name.slice(0, 1)}</span>
      <span>{SITE.name}</span>
    </a>

    <nav class="nav-links" aria-label="主导航">
      {
        links.map((link) => (
          <a class="nav-link" href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <button id="palette-open" class="kbd-btn" type="button" aria-haspopup="dialog" aria-label="打开命令面板">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
        <span class="kbd-hint-label">搜索</span>
        <kbd id="kbd-hint">Ctrl K</kbd>
      </button>

      <button id="theme-toggle" class="icon-btn" type="button" aria-label="切换深色模式" title="切换深色模式">
        <svg class="icon icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
        <svg class="icon icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></svg>
      </button>

      <button id="mobile-menu-btn" class="icon-btn mobile-menu-btn" type="button" aria-expanded="false" aria-controls="mobile-panel" aria-label="菜单">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16"/><path d="M4 12h16"/><path d="M4 17h16"/></svg>
      </button>
    </div>
  </div>

  <div id="mobile-panel" class="mobile-panel wrap">
    {
      links.map((link) => (
        <a class="nav-link" href={withBase(link.href)} aria-current={isActive(link.href) ? 'page' : undefined}>
          {link.label}
        </a>
      ))
    }
  </div>
</header>
