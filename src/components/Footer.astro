---
import { SITE } from '../config';

const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base === '/' ? p : base.replace(/\/$/, '') + p);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap footer-inner">
    <p class="footer-note">
      © {year} {SITE.name} · 一座由 Markdown 生长出来的数字花园
    </p>
    <nav class="footer-links" aria-label="页脚导航">
      <a href={withBase('/notes/')}>笔记</a>
      <a href={withBase('/graph/')}>图谱</a>
      <a href={withBase(SITE.social.rss)}>RSS</a>
      <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
      <a href={SITE.social.email}>邮箱</a>
    </nav>
  </div>
</footer>
