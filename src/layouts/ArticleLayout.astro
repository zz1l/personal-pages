---
import BaseLayout from './BaseLayout.astro';
import type { Note } from '../lib/notes';
import { noteSlug, updated, readingTime } from '../lib/notes';
import { formatDateLong } from '../lib/format';
import { DIFFICULTY_LABELS } from '../config';
import RelatedNotes from '../components/RelatedNotes.astro';
import { relatedNotes, backlinks } from '../lib/graph';

interface Props {
  note: Note;
  Content: any;
}

const { note, Content } = Astro.props;
const slug = noteSlug(note);
const base = import.meta.env.BASE_URL;
const withBase = (p: string) => (base === '/' ? p : base.replace(/\/$/, '') + p);
const related = relatedNotes(slug, 5);
const incoming = backlinks(slug);
const categoryLabel = note.data.subcategory
  ? `${note.data.category} · ${note.data.subcategory}`
  : note.data.category;
---

<BaseLayout
  title={`${note.data.title} · ${note.data.category}`}
  description={note.data.description || note.data.title}
  type="article"
  canonical={`/notes/${slug}/`}
  published={note.data.created}
>
  <div id="reading-progress" class="reading-progress" aria-hidden="true"></div>

  <div class="wrap">
    <div class="article-layout">
      <aside class="article-toc" aria-label="目录">
        <nav class="toc">
          <details open>
            <summary>目录</summary>
            <ol class="toc-list" id="toc-list"></ol>
          </details>
        </nav>
      </aside>

      <div class="article-main">
        <nav class="breadcrumb" aria-label="面包屑导航">
          <a href={withBase('/')}>首页</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href={withBase('/notes/')}>笔记</a>
          <span class="sep" aria-hidden="true">/</span>
          <a href={withBase('/notes/?category=' + encodeURIComponent(note.data.category))}>
            {note.data.category}
          </a>
          {note.data.subcategory && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <span>{note.data.subcategory}</span>
            </>
          )}
        </nav>

        <header class="article-header">
          <h1>{note.data.title}</h1>
          <div class="prose-note-badge-row">
            <span class="difficulty-badge">{DIFFICULTY_LABELS[note.data.difficulty]}</span>
          </div>
          <p class="article-meta">
            {categoryLabel} · 更新于 {formatDateLong(updated(note))} · 约 {readingTime(note)} 分钟读完
          </p>
        </header>

        <div class="prose article-content">
          <Content />
        </div>

        <footer class="article-footer">
          {
            incoming.length > 0 && (
              <section class="mb-10" aria-label="被引用的笔记">
                <h2 class="text-sm font-semibold tracking-wide uppercase text-subtle mb-4">
                  被以下笔记引用
                </h2>
                <ul class="list-none p-0 m-0 grid gap-2">
                  {
                    incoming.map((n) => (
                      <li>
                        <a class="flex items-baseline gap-3 py-1 group" href={withBase('/notes/' + n.slug + '/')}>
                          <span class="text-xs text-subtle font-mono flex-none">{n.category}</span>
                          <span class="text-sm text-fg group-hover:text-accent transition-colors">
                            {n.title}
                          </span>
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </section>
            )
          }
          <RelatedNotes notes={related} />
        </footer>
      </div>
    </div>
  </div>
</BaseLayout>
